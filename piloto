<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CoPi · Tu trabajo, más cerca</title>
<link rel="manifest" href="manifest.webmanifest"><meta name="theme-color" content="#22C55E"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><link rel="apple-touch-icon" href="icons/icon-192.png">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef2ef;--ph:#fff;--card:#f1faf4;--card2:#fff;--tx:#0F2A3A;--mu:#6b7c86;--g:#22C55E;--g2:#16A34A;--gl:#dcfce7;--pet:#0F2A3A;--ln:#e3ebe6;--in:#f5f7f6;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1218;--ph:#101c24;--card:#14262b;--card2:#16252e;--tx:#e8f1ec;--mu:#92a4ad;--gl:#12351f;--ln:#22343d;--in:#182932;--pet:#0a1a24;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0b1218;--ph:#101c24;--card:#14262b;--card2:#16252e;--tx:#e8f1ec;--mu:#92a4ad;--gl:#12351f;--ln:#22343d;--in:#182932;--pet:#0a1a24;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{min-height:100%;margin:0}
body{background:var(--bg);color:var(--tx);font-family:'Nunito',system-ui,-apple-system,'Segoe UI',sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center}
.demo{font-size:12px;color:var(--mu);padding:6px;display:none;gap:6px;align-items:center}
.demo button{border:1px solid var(--ln);background:var(--card2);color:var(--tx);border-radius:99px;padding:5px 12px;font:inherit;font-weight:700;cursor:pointer}
.demo button.on{background:var(--g);color:#fff;border-color:var(--g)}
.phone{position:relative;width:100%;height:100vh;height:100dvh;background:var(--ph);overflow:hidden;display:flex;flex-direction:column}
@media(min-width:600px){.demo{display:flex}body{height:100vh}.phone{width:390px;height:min(820px,calc(100vh - 50px));border-radius:42px;border:9px solid #111;box-shadow:0 20px 60px rgba(0,0,0,.3)}}
.scr{flex:1;overflow-y:auto;padding:18px 16px 16px}
h1{font-size:24px;margin:0 0 6px;font-weight:900}h2{font-size:17px;margin:14px 0 8px;font-weight:900}p{margin:4px 0;color:var(--mu);font-size:14px}
.card{background:var(--card);border-radius:20px;padding:14px;margin-bottom:12px}.w{background:var(--card2);border:1px solid var(--ln)}
.btn{display:block;width:100%;border:0;border-radius:16px;padding:15px;font:inherit;font-weight:800;font-size:16px;cursor:pointer;background:var(--g);color:#fff;margin-top:10px;text-align:center}
.btn.s{background:var(--in);color:var(--tx)}.btn.p{background:var(--pet);color:#fff}.btn.sm{display:inline-block;width:auto;padding:9px 16px;font-size:14px;margin:0}.btn.r{background:#ef4444}
.lnk{background:none;border:0;color:var(--g2);font:inherit;font-weight:800;cursor:pointer;padding:10px;width:100%}
label{display:block;font-size:13px;font-weight:800;margin:12px 0 5px}
input,select,textarea{width:100%;border:1.5px solid var(--ln);background:var(--in);color:var(--tx);border-radius:14px;padding:13px;font:inherit;font-size:16px}
input:focus{outline:2px solid var(--g)}
.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{border:1.5px solid var(--ln);background:var(--in);color:var(--tx);border-radius:99px;padding:9px 14px;font:inherit;font-weight:700;font-size:14px;cursor:pointer}
.chip.on{background:var(--g);border-color:var(--g);color:#fff}
.mas{display:block;margin:0 auto;object-fit:contain}
.big{font-size:40px;font-weight:900;line-height:1.1}.row{display:flex;justify-content:space-between;align-items:center;gap:8px}
.bar{height:11px;border-radius:9px;background:var(--ln);overflow:hidden;margin:8px 0 4px}.bar i{display:block;height:100%;background:var(--g);border-radius:9px}
.mu{color:var(--mu);font-size:12px}.tag{display:inline-block;background:var(--gl);color:var(--g2);font-weight:800;font-size:12px;border-radius:99px;padding:4px 10px}
.bars{display:flex;align-items:flex-end;gap:6px;height:130px;padding-top:6px}.bars div{flex:1;text-align:center;font-size:10px;color:var(--mu);display:flex;flex-direction:column;justify-content:flex-end;height:100%}.bars b{display:block;background:linear-gradient(var(--g),var(--g2));border-radius:6px 6px 3px 3px;margin-bottom:4px}.bars em{font-style:normal;font-weight:800;color:var(--tx);font-size:9.5px;margin-bottom:2px}
.nav{display:flex;align-items:center;justify-content:space-around;border-top:1px solid var(--ln);background:var(--ph);padding:8px 4px 10px}
.nav button{background:none;border:0;color:var(--mu);font:inherit;font-size:11px;font-weight:700;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;flex:1}.nav button.on{color:var(--g2)}
.nav svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.nav .plus{flex:0 0 58px;height:58px;border-radius:50%;background:var(--g);color:#fff;font-size:34px;margin-top:-26px;box-shadow:0 6px 16px rgba(34,197,94,.5);justify-content:center;line-height:1}
.ov{position:absolute;inset:0;background:rgba(0,0,0,.45);display:flex;flex-direction:column;justify-content:flex-end;align-items:center;z-index:9;padding-bottom:84px}
.fab{display:flex;gap:14px}.fab button{background:var(--card2);color:var(--tx);border:0;border-radius:20px;padding:14px 18px;font:inherit;font-weight:800;font-size:14px;display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.25)}.fab span{font-size:30px}
.sheet{position:absolute;inset:0;background:var(--ph);z-index:10;display:flex;flex-direction:column;padding:18px 16px;overflow-y:auto}
.li{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--ln)}.li .ic{width:38px;height:38px;border-radius:12px;background:var(--gl);display:grid;place-items:center;font-size:19px}.li div:nth-child(2){flex:1;font-weight:800;font-size:14px}.pos{color:var(--g2);font-weight:900}.neg{color:#ef4444;font-weight:900}
.seg{display:flex;background:var(--in);border-radius:14px;padding:4px;margin-bottom:12px}.seg button{flex:1;border:0;background:none;color:var(--mu);font:inherit;font-weight:800;padding:9px;border-radius:11px;cursor:pointer}.seg button.on{background:var(--g);color:#fff}
.prem{background:var(--pet);color:#fff;border-radius:22px;padding:18px}.prem p,.prem li{color:#cfe3da}.prem ul{padding-left:0;list-style:none;margin:12px 0}.prem li{margin:9px 0;font-size:15px}.prem li:before{content:"✓ ";color:var(--g);font-weight:900}
.lock{position:relative}.lock>.lk{position:absolute;inset:0;background:color-mix(in srgb,var(--ph) 82%,transparent);backdrop-filter:blur(3px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px;border-radius:20px;z-index:2}
@keyframes w{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}.wv{display:flex;gap:5px;align-items:center;justify-content:center;height:50px}.wv i{width:6px;height:46px;border-radius:4px;background:var(--g);animation:w 1s infinite}
.back{background:none;border:0;color:var(--tx);font:inherit;font-weight:800;font-size:15px;cursor:pointer;padding:0 0 8px}
svg.map{width:100%;border-radius:20px;background:var(--card)}
.toast{position:absolute;left:16px;right:16px;bottom:90px;background:var(--pet);color:#fff;border-radius:14px;padding:12px 14px;z-index:20;font-weight:700}.demo.off{display:none!important}textarea{resize:none}</style></head>
<body>
<div class="demo">Demo: <button id="dg">Gratis</button><button id="dp">Premium</button></div>
<div class="phone" id="app"></div>
<script src="config.js"></script>
<script>
const M={hello:'img/hello.png',listen:'img/listen.png',map:'img/map.png',fist:'img/fist.png'};
const $=s=>document.querySelector(s);
const CFG=window.COPI_CONFIG||{API:''};
const DEMO=!CFG.API||/[?&]demo=1/.test(location.search);
const LS={get(k){try{return JSON.parse(localStorage.getItem(k))}catch(e){return null}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
let SES=LS.get('ses')||{};
const SR=window.SpeechRecognition||window.webkitSpeechRecognition,CAN_SR=!!SR;
const ERR={codigo_invalido_o_usado:'Ese código no existe o ya se usó.',telefono_ya_registrado:'Ese teléfono ya está registrado. Iniciá sesión.',datos_incorrectos:'Teléfono o código incorrectos.',falta_consentimiento:'Tenés que aceptar para continuar.',offline:'Sin conexión. Probá de nuevo.'};
function err(e){s.err=ERR[e]||e;s.keep=1;const el=$('#er');if(el)el.textContent=s.err}
async function api(b){if(DEMO)return{ok:true,demo:true};
 try{const r=await fetch(CFG.API,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(b)});return await r.json()}
 catch(e){if(['addEntry','event','connection'].includes(b.action)){const q=LS.get('q')||[];q.push(b);LS.set('q',q)}return{ok:false,error:'offline'}}}
async function flush(){const q=LS.get('q')||[];if(!q.length||DEMO)return;LS.set('q',[]);for(const b of q)await api(b)}
const ev=(e,d)=>SES.uid?api({action:'event',userId:SES.uid,codigo:SES.code,evento:e,detalle:d||''}):0;
async function load(){const r=await api({action:'getEntries',userId:SES.uid,codigo:SES.code});if(r.ok&&r.entries)s.ent=r.entries.map(e=>({t:e.tipo,c:e.categoria,a:+e.monto,d:String(e.fecha).slice(0,10)}))}
const b64=f=>new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]);r.onerror=no;r.readAsDataURL(f)});
const shrink=f=>new Promise((ok,no)=>{const im=new Image(),u=URL.createObjectURL(f);im.onload=()=>{const k=Math.min(1,1400/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);ok(c.toDataURL('image/jpeg',.8).split(',')[1])};im.onerror=no;im.src=u});
function lp(t){const x=t.toLowerCase(),m=x.match(/(\d+(?:[.,]\d+)?)\s*(mil|k|lucas)?/);if(!m)return null;
 const n=m[1];let a=/^\d{1,3}(\.\d{3})+$/.test(n)?+n.replace(/\./g,''):parseFloat(n.replace(',','.'));if(m[2]&&a<1000)a*=1000;
 const inc=/cobr|pagaron|dieron|ingres|gan[eé]|propina/.test(x)&&!/gast|puse|compr|pagu[eé]/.test(x);
 const c=inc?(/propina/.test(x)?'Propina':/aparte|efectivo/.test(x)?'Cobro aparte':'Cobro de app'):/nafta|combustible|gnc|gasoil|carg[uú]e/.test(x)?'Combustible':/comida|com[ií]|almuerzo|caf[eé]|cena/.test(x)?'Mi comida':/limpi|lav/.test(x)?'Limpieza':/arreglo|taller|mec[aá]nic|service|cubierta|rueda|aceite|repar/.test(x)?'Arreglos del vehículo':'Otro gasto';
 return{t:inc?'inc':'exp',c,a}}
const fmt=n=>(n<0?'-':'')+'$'+Math.abs(Math.round(n)).toLocaleString('es-AR');
const mas=(k,w)=>`<img class="mas" src="${M[k]}" width="${w}" alt="CoPi">`;
const ALL=['DiDi','Rappi','Uber','PedidosYa','Cabify','Particular','Otra'];
const INC=[['💵','Cobro de app'],['🙌','Propina'],['🧾','Cobro aparte']];
const EXP=[['⛽','Combustible'],['🔧','Arreglos del vehículo'],['🧼','Limpieza'],['🍔','Mi comida']];
const HW=[12400,18700,22100,16500,24800,20300,13600],DN=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'],GOAL=180000;
let s={scr:'welcome',tab:'home',prem:false,name:'Facu',work:'Repartidor',apps:['Rappi','PedidosYa','Uber'],conn:[],range:'week',day:0,mo:0,ent:[],newCats:{inc:[],exp:[]},plus:false,pl:null,from:'onb',f:{t:'exp',c:'Combustible',a:'',n:'',cr:0},mic:null,since:null,min:0,saveMin:0};
const today=new Date();today.setHours(12,0,0,0);
const key=d=>d.toISOString().slice(0,10);
const addD=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x};
const mon=addD(today,-((today.getDay()+6)%7));
const rnd=i=>{let x=Math.sin(i*12.9898)*43758.5453;return x-Math.floor(x)};
function net(d){if(!DEMO)return 0;const diff=Math.round((d-mon)/864e5);if(diff>=0&&diff<7)return HW[diff];return Math.round((11000+rnd(Math.floor(d/864e5))*14000)/100)*100}
function day(d){const n=net(d),inc=Math.round(n/.8/100)*100,ex=inc-n;
 const it=[{t:'inc',ic:'💵',c:'Cobro de app',a:Math.round(inc*.86)},{t:'inc',ic:'🙌',c:'Propina',a:inc-Math.round(inc*.86)},
 {t:'exp',ic:'⛽',c:'Combustible',a:Math.round(ex*.6)},{t:'exp',ic:'🍔',c:'Mi comida',a:Math.round(ex*.25)},{t:'exp',ic:'🧼',c:'Limpieza',a:ex-Math.round(ex*.6)-Math.round(ex*.25)}];
 s.ent.filter(e=>e.d==key(d)).forEach(e=>it.push({t:e.t,ic:e.ic,c:e.c,a:e.a}));return it.filter(x=>x.a>0)}
const sum=it=>{const i=it.filter(x=>x.t=='inc').reduce((a,x)=>a+x.a,0),e=it.filter(x=>x.t=='exp').reduce((a,x)=>a+x.a,0);return{i,e,n:i-e}};
function period(){
 if(s.range=='day'){const d=addD(mon,s.day),it=day(d);return{bars:null,it,...sum(it)}}
 if(s.range=='week'){const ds=[0,1,2,3,4,5,6].map(i=>addD(mon,i)),all=ds.flatMap(day);return{labels:DN,bars:ds.map(d=>sum(day(d)).n),it:agg(all),...sum(all)}}
 const f=new Date(today.getFullYear(),today.getMonth()-s.mo,1),l=new Date(today.getFullYear(),today.getMonth()-s.mo+1,0);let ds=[];
 for(let d=new Date(f);d<=l&&(s.mo>0||d<=today);d=addD(d,1))ds.push(new Date(d));
 const wk=[],all=[];ds.forEach((d,i)=>{const it=day(d);all.push(...it);const w=Math.floor(i/7);wk[w]=(wk[w]||0)+sum(it).n});
 return{labels:wk.map((_,i)=>'Sem '+(i+1)),bars:wk,it:agg(all),...sum(all)}}
function agg(it){const m={};it.forEach(x=>{const k=x.t+x.c;m[k]=m[k]||{...x,a:0};m[k].a+=x.a});return Object.values(m)}
const bars=(b,l)=>{const mx=Math.max(1,...b);return `<div class="bars">${b.map((v,i)=>`<div><em>${v>=1000?(v/1000).toFixed(1)+'k':v}</em><b style="height:${v/mx*78}%"></b>${l[i]}</div>`).join('')}</div>`};
const ico=p=>`<svg viewBox="0 0 24 24">${p}</svg>`;
const NAV=[['home','Inicio',ico('<path d="M3 11l9-8 9 8v10H3z"/>')],['act','Actividad',ico('<path d="M5 20V10M12 20V4M19 20v-7"/>')],['plus','',''],['map','Mapa',ico('<path d="M12 21s7-6 7-11a7 7 0 10-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>')],['me','Perfil',ico('<circle cx="12" cy="8" r="4"/><path d="M4 21c1-5 15-5 16 0"/>')]];
const premBox=()=>`<div class="prem"><h2 style="margin:0">Premium: $6.000 por mes</h2><ul><li>Subí capturas de tus apps y CoPi lee tus ingresos</li><li>Recomendaciones de cuándo, dónde y con qué app salir</li><li>Carga por voz sin límites</li></ul><p>Contratalo cuando quieras y date de baja cuando quieras.${DEMO?'':' <b>Por ahora estamos probando: no se cobra nada.</b>'}</p></div>`;
const hrs=()=>{let m=s.min+(s.since?Math.round((Date.now()-s.since)/6e4):0);return Math.floor(m/60)+' h '+m%60+' min'};

/* ---------- pantallas ---------- */
const V={
welcome:()=>`<div class="scr" style="display:flex;flex-direction:column;justify-content:center;text-align:center">${mas('hello',190)}<h1 style="margin-top:12px">¡Hola! Bienvenid@ ;)</h1><p>Tu trabajo, más cerca</p><button class="btn" data-a="go:register">Registrarse</button><button class="btn s" data-a="go:login">Iniciar sesión</button></div>`,
login:()=>`<div class="scr"><button class="back" data-a="go:welcome">← Volver</button><h1>Iniciar sesión</h1><label>Teléfono</label><input id="u" type="tel" inputmode="tel" autocomplete="tel"><label>Tu código de invitación</label><input id="p" autocapitalize="characters"><p id="er" style="color:#ef4444">${s.err||''}</p><button class="btn" data-a="login">Entrar</button><p style="text-align:center">¿Perdiste tu código? Pedíselo al equipo de CoPi.</p></div>`,
forgot:()=>`<div class="scr"><button class="back" data-a="go:login">← Volver</button><h1>Recuperar contraseña</h1><p>Ingresá tu número o correo y te mandamos un enlace.</p><label>Número o correo</label><input><button class="btn" data-a="forgot">Enviar enlace</button></div>`,
register:()=>`<div class="scr"><button class="back" data-a="go:welcome">← Volver</button><h1>Registrate</h1><label>Código de invitación</label><input id="rc" autocapitalize="characters" placeholder="PILOTO-001"><label>Nombre</label><input id="rn"><label>Correo</label><input id="re" type="email" inputmode="email"><label>N° de teléfono</label><input id="rt" type="tel" inputmode="tel"><label>Género</label><select id="rg"><option>Prefiero no decir</option><option>Femenino</option><option>Masculino</option><option>Otro</option></select><label>Sobre tu trabajo</label><div class="chips">${['Repartidor','Conductor','Ambos'].map(w=>`<button class="chip ${s.work==w?'on':''}" data-a="work:${w}">${w}</button>`).join('')}</div><label>¿Con qué apps trabajás?</label><div class="chips">${ALL.map(a=>`<button class="chip ${s.apps.includes(a)?'on':''}" data-a="app:${a}">${a}</button>`).join('')}</div><label style="display:flex;gap:8px;align-items:flex-start;font-weight:600"><input id="rk" type="checkbox" style="width:22px;height:22px;flex:none;margin-top:2px">Acepto que CoPi guarde mis datos de trabajo, ingresos y gastos para este piloto. Puedo pedir que me los borren cuando quiera.</label><p id="er" style="color:#ef4444">${s.err||''}</p><button class="btn" data-a="reg">Crear cuenta</button></div>`,
offer:()=>`<div class="scr" style="text-align:center">${mas('fist',120)}${premBox()}<button class="btn" data-a="buy">${DEMO?'Quiero Premium':'Avisame cuando esté'}</button><button class="btn s" data-a="free">Seguir gratis</button></div>`,
connect:()=>`<div class="scr"><h1>Conectá tus apps</h1><p>Elegí las que quieras. CoPi trae tus ingresos solo, sin que escribas nada.</p><div class="card w" style="margin-top:12px">${ALL.filter(a=>a!='Particular'&&a!='Otra'||s.apps.includes(a)).concat(s.apps.filter(a=>!ALL.includes(a))).map(a=>`<div class="li"><div class="ic">📱</div><div>${a}<div class="mu">${s.conn.includes(a)?'Conectada':s.apps.includes(a)?'Elegida en tu registro':'Disponible'}</div></div>${s.conn.includes(a)?'<span class="tag">✓</span>':`<button class="btn sm" data-a="pl:${a}">Conectar</button>`}</div>`).join('')}</div><p class="mu">Conexión mediante Palenca, con tu autorización. Podés desconectarte cuando quieras.</p><button class="btn" data-a="done">Finalizar</button></div>`,
home:()=>{const n=[0,1,2,3,4,5,6].reduce((a,i)=>a+sum(day(addD(mon,i))).n,0),pc=Math.min(100,Math.round(n/GOAL*100));
 const goal=`<div class="card"><div class="row"><div><b>${s.prem?'Ganancia neta semanal':'Tu ganancia neta semanal'}</b><div class="big">${fmt(n)}</div></div>${s.prem?'<span class="tag">★ Vas muy bien</span>':mas('hello',92)}</div><div class="bar"><i style="width:${pc}%"></i></div><div class="row mu"><span>${pc}% completado</span><span>${s.prem?'Faltan '+fmt(Math.max(0,GOAL-n)):'Meta '+fmt(GOAL)}</span></div></div>`;
 const ch=`<div class="card w"><b>Tus ganancias por día (semana)</b>${bars([0,1,2,3,4,5,6].map(i=>sum(day(addD(mon,i))).n),DN)}</div>`;
 const hr=!s.prem?`<div class="card w row"><div><b>Horas trabajadas</b><div class="mu">${hrs()}</div></div><button class="btn sm ${s.since?'r':''}" data-a="clock">${s.since?'Terminé':'Empecé a trabajar'}</button></div>`:'';
 if(!s.prem)return `<div class="scr"><div class="row"><h1 style="font-size:30px">Copi</h1><span class="tag">Versión gratuita</span></div>${goal}${ch}${hr}<div class="prem" style="margin-bottom:12px"><div class="row"><div><b>👑 Pasate a Premium</b><p>Se carga solo y te recomienda cuándo y dónde salir.</p></div><b style="font-size:20px">$6.000<br><span style="font-size:11px;font-weight:600">por mes</span></b></div><button class="btn" data-a="go:offer">Quiero Premium →</button></div><div class="card w row" data-a="doc" style="cursor:pointer"><span>📷 <b>Subí una foto de tu comprobante</b><div class="mu">y llevá un registro de tus ingresos</div></span>›</div></div>`;
